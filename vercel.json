{
  "trailingSlash": false,
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "bunVersion": "1.x",
  "headers": [
    {
      "source": "/_next/image/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}